#include <iostream>
using namespace std;

int main() {
    int a[5], key;
    bool found = false;

    for (int i = 0; i < 5; i++)
        cin >> a[i];

    cout << "Enter element to search: ";
    cin >> key;

    for (int i = 0; i < 5; i++) {
        if (a[i] == key) {
            cout << "Found at position " << i + 1;
            found = true;
            break;
        }
    }

    if (!found)
        cout << "Element not found";

    return 0;
}
