#include <iostream>
using namespace std;

struct Student {
    int roll;
    char name[30];
};

int main() {
    Student s[3];

    for (int i = 0; i < 3; i++) {
        cout << "Enter roll and name: ";
        cin >> s[i].roll >> s[i].name;
    }

    cout << "\nStudent details:\n";

    for (int i = 0; i < 3; i++)
        cout << s[i].roll << " " << s[i].name << endl;

    return 0;
}
