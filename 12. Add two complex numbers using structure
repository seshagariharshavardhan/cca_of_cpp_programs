#include <iostream>
using namespace std;

struct Complex {
    float real, imag;
};

int main() {
    Complex a, b, sum;

    cout << "Enter first complex number: ";
    cin >> a.real >> a.imag;

    cout << "Enter second complex number: ";
    cin >> b.real >> b.imag;

    sum.real = a.real + b.real;
    sum.imag = a.imag + b.imag;

    cout << "Sum = " << sum.real;
    if (sum.imag >= 0)
        cout << " + " << sum.imag << "i";
    else
        cout << " - " << -sum.imag << "i";

    return 0;
}
